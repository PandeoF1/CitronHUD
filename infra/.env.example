# Copier en .env puis remplacer chaque valeur.
# Générer les secrets avec :  openssl rand -base64 32

# Domaine servi par Caddy. Doit pointer vers ce serveur (enregistrement A/AAAA).
DOMAIN=hud.citron.gg
# URL publique complète, utilisée dans les liens renvoyés par l'API.
PUBLIC_URL=https://hud.citron.gg

POSTGRES_PASSWORD=change-moi

MINIO_ROOT_USER=citronhud
MINIO_ROOT_PASSWORD=change-moi-aussi
S3_BUCKET=citronhud

# Signe les sessions de l'interface admin. Le changer déconnecte tout le monde.
AUTH_SECRET=change-moi-egalement
