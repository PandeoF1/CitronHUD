{
  "name": "@citronhud/client",
  "version": "0.1.0",
  "private": true,
  "description": "Client CitronHUD — serveur local, détection GSI, capture des temps forts et panneau de contrôle.",
  "main": "./out/main/index.js",
  "author": "Citron Esport",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json --composite false && tsc --noEmit -p tsconfig.web.json --composite false",
    "postinstall": "electron-builder install-app-deps",
    "package:win": "electron-vite build && electron-builder --win",
    "package:linux": "electron-vite build && electron-builder --linux",
    "package:mac": "electron-vite build && electron-builder --mac"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "better-sqlite3": "^11.9.1",
    "cors": "^2.8.5",
    "electron-updater": "^6.6.2",
    "express": "^4.21.2",
    "ffmpeg-static": "^5.2.0",
    "obs-websocket-js": "^5.0.6",
    "socket.io": "^4.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@citronhud/contracts": "workspace:*",
    "@citronhud/gsi": "workspace:*",
    "@citronhud/overlay": "workspace:*",
    "@citronhud/theme": "workspace:*",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@types/adm-zip": "^0.5.7",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "electron": "^35.1.4",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "socket.io-client": "^4.8.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "zustand": "^5.0.3"
  }
}
