# Copier en .env.local pour le développement.
# En production, ces variables viennent de infra/docker-compose.yml.

DATABASE_URL=postgres://citron:citron@localhost:5432/citronhud

# Signe les sessions de l'interface admin. `openssl rand -base64 32`
AUTH_SECRET=dev-secret-a-remplacer

# URL publique du serveur, utilisée dans les liens renvoyés par l'API.
PUBLIC_URL=http://localhost:3000

# Stockage objet (MinIO en production, facultatif en développement : sans lui,
# les routes de téléversement répondent 503 et le reste fonctionne).
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=citronhud
S3_ACCESS_KEY=citronhud
S3_SECRET_KEY=citronhud
S3_PUBLIC_URL=http://localhost:9000/citronhud

# Compte administrateur créé par `pnpm db:seed`.
SEED_ADMIN_EMAIL=admin@citron.gg
SEED_ADMIN_PASSWORD=citron-admin
